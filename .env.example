# Configuration for Live Market & On-chain Data Engine

# 1. Alchemy RPC URL (Ethereum Mainnet)
# Get a free API key at https://www.alchemy.com/
# Used by onchain_engine.py to query:
#   - Chainlink ETH/USD Aggregator (round data, latest price, oracle staleness)
#   - Uniswap V3 USDC/WETH Pool (token0/token1 balances, TVL proxy)
ALCHEMY_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# 2. Binance Public Spot API
# No API key required for public market endpoints:
#   - Realtime ETH/USDT spot ticker: https://api.binance.com/api/v3/ticker/price
#   - 3-year daily klines (1095 days): https://api.binance.com/api/v3/klines
